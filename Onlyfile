!shell bash

# Build on debug mode
b():
    cargo build

# Build on release mode
rb(args..):
    cargo build --release

# Run with args on debug mode
r(args..):
    cargo run -- {{ args }}

# Build the release binary for installation
_release_build():
    cargo build --release

# Install the local kocr CLI
install() & _release_build:
    mkdir -p "$HOME/.local/bin"
    cp target/release/kocr "$HOME/.local/bin/.kocr-install"
    chmod +x "$HOME/.local/bin/.kocr-install"
    mv "$HOME/.local/bin/.kocr-install" "$HOME/.local/bin/kocr"
    echo "Installed kocr to $HOME/.local/bin"
    du -sh $(which kocr)

# Uninstall the local kocr CLI
uninstall():
    rm -f "$HOME/.local/bin/kocr"
    echo "Uninstalled kocr"

# Run the local CI
ci() & check & test:
    echo 'CI done.'

# Fmt, check and clippy
check():
    cargo fmt --all
    cargo check --all-targets
    cargo clippy --all-targets -- -D warnings

# Run tests
test() ? @has("cargo-nextest"):
    cargo nextest run

test():
    cargo test --all-targets --workspace

# Remove build and generated model artifacts
clean():
    cargo clean
    find PaddleOCR -maxdepth 1 -type d -name 'kdeocr-ppocrv6-*-r*' -exec rm -r -- {} +
    find PaddleOCR -maxdepth 1 -type f -name 'kdeocr-ppocrv6-*-r*.tar.zst' -delete

# Show current version
show():
    uv run scripts/version.py show

# Update version and publish
publish(version):
    test -z "$(git status --porcelain)"
    uv run scripts/version.py change {{ version }}
    uv run scripts/notice.py
    only ci
    git add -- Cargo.toml Cargo.lock NOTICE
    git commit -m "chore: update to {{ version }}"
    git tag {{ version }}
    git push --atomic origin HEAD {{ version }}

// ========================================
[bundle]
# Bundle small to tar.zst
small() ? @has("uv"):
    uv run PaddleOCR/bundle.py --name ppocrv6-small-r1

# Bundle medium to tar.zst
medium() ? @has("uv"):
    uv run PaddleOCR/bundle.py --name ppocrv6-medium-r1
